# Test environment (loaded automatically when APP_ENV=testing). Never point this at a real database:
# destructive commands and RefreshDatabase refuse unless the database name ends in _test.
APP_NAME="Local Selection WMS"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bwms_test
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ordermentum API token (x-api-key). Username/password auth is not supported.
ORDERMENTUM_API_KEY=
ORDERMENTUM_BASE_URL=https://api.ordermentum.com
ORDERMENTUM_STOCK_URL=https://stock.ordermentum.com
ORDERMENTUM_SUPPLIER_ID=
ORDERMENTUM_LOCATION_ID=
# Stock API supplier headers: plain (context-*), x or both; confirm with om:probe
ORDERMENTUM_CONTEXT_HEADERS=plain

# bwms:migrate-legacy source: restored legacy dump, SELECT-only user (never production)
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_DATABASE=bwms_legacy_prod
LEGACY_DB_USERNAME=bwms_legacy_ro
LEGACY_DB_PASSWORD=
# Ordermentum sync switches (off until cutover) and webhook path token (long random string)
ORDERMENTUM_PUSH_ENABLED=false
ORDERMENTUM_INGEST_ENABLED=false
ORDERMENTUM_WEBHOOK_TOKEN=
# Line item variant ID path (confirmed by om:probe on a live order, 2026-10-27)
ORDERMENTUM_LINE_VARIANT_FIELDS=variantId
# Webhook signature (x-ordermentum-signature, HMAC-SHA256): secret via `php artisan om:probe secret --write-env`
ORDERMENTUM_WEBHOOK_SECRET=
ORDERMENTUM_WEBHOOK_SIGNATURE_MODE=enforce
# Set false only after a real signed event verified (then /webhooks/ordermentum works without the path token)
ORDERMENTUM_WEBHOOK_REQUIRE_TOKEN=true

# Portal integration (spec B4.4). Inbound keys "keyId:secret[,keyId2:secret2]"; outbound key for BWMS -> portal calls.
PORTAL_API_ENABLED=false
PORTAL_API_KEYS=
PORTAL_BASE_URL=
PORTAL_OUTBOUND_KEY_ID=
PORTAL_OUTBOUND_SECRET=
PORTAL_PUSH_ENABLED=false
PORTAL_EVENTS_ENABLED=false
